{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory-inject.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/memory-inject.py\"",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory-log.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/memory-log.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory-log.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/memory-log.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}